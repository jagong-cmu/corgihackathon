{
  "name": "corgihackathon-whiteboard",
  "private": true,
  "version": "0.1.7.0",
  "type": "module",
  "description": "Visual/animation subsystem for an AI voice tutor. Renders a versioned Visual Spec (JSON) as draw-on whiteboard animations.",
  "workspaces": [
    "packages/canvas-protocol",
    "tools/cue-inspector"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "start": "tsx server/prod.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit false",
    "test:spec": "tsx scripts/testSpec.ts",
    "test:rag": "tsx scripts/testRag.ts",
    "test:tutors": "tsx scripts/testTutors.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@tutor/canvas-protocol": "*",
    "adm-zip": "^0.6.0",
    "animejs": "^3.2.2",
    "katex": "^0.16.11",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "mafs": "^0.21.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/animejs": "^3.1.12",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
